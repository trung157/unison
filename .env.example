# Tên hiển thị của phòng (tiêu đề trang, tên app khi cài lên điện thoại)
APP_NAME=Unison
PORT=3456
# Bắt buộc để tìm và thêm bài YouTube — xem README
YT_API_KEY=
# Mã phòng: để trống thì ai có link cũng vào được
ROOM_CODE=
# Mã chủ phòng
ADMIN_CODE=
MAX_DURATION_MIN=15
MAX_PER_USER=5
AUTO_RESUME_MIN=30
# Nơi sao lưu hằng ngày (mặc định ./backups)
BACKUP_DIR=
# Đứng sau proxy thì đặt để chống dò mã theo đúng IP người dùng:
#   cloudflare = tin header CF-Connecting-IP (Cloudflare Tunnel)
#   proxy      = tin X-Forwarded-For (nginx, Caddy…)
# Để trống khi người dùng nối thẳng vào máy chủ. ĐỪNG bật khi không có proxy — header này giả được.
TRUST_PROXY=
